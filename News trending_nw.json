    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Summarize Headlines - robust version\ndata = items[0].get(\"json\", {}) if items else {}\narticles = data.get(\"articles\", [])[:5]  # top 5\nsummaries = []\nfor art in articles:\n    summaries.append({\n        \"title\": art.get(\"title\", \"\"),\n        \"summary\": art.get(\"description\") or art.get(\"content\") or \"\"\n    })\n# Return a single item with `summaries` array\nreturn [{\"json\": {\"summaries\": summaries}}]\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        80
      ],
      "id": "196c28f9-78fc-48bf-84b5-af24e9eb8898",
      "name": "Summarize Headlines"
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "# Normalize LLM Output (Python)\ndata = items[0].get(\"json\", {}) if items else {}\n\nenhanced = (\n    data.get(\"text\")\n    or data.get(\"output\")\n    or data.get(\"response\")\n    or data.get(\"result\")\n    or \"\"\n)\n\nif not enhanced and \"choices\" in data and data[\"choices\"]:\n    choice = data[\"choices\"][0]\n    enhanced = (\n        choice.get(\"message\", {}).get(\"content\")\n        or choice.get(\"text\")\n        or \"\"\n    )\n\nenhanced = enhanced or data.get(\"body\") or data.get(\"message\") or \"\"\n\nreturn [{\"json\": {\"enhanced_insights\": enhanced}}]\n"
      },
